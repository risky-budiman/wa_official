# ===========================================
# WhatsApp CRM Backend — Environment Variables
# ===========================================

# Server
PORT=3000
NODE_ENV=development
# NODE_ENV=production  # <-- Ubah ke production saat deploy

# CORS (isi domain frontend saat production)
CORS_ORIGIN=*
# CORS_ORIGIN=https://crm.domainanda.com  # <-- Production

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wa_crm

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (WAJIB ganti di production!)
JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=my-custom-verify-token
META_API_VERSION=v20.0

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wa-crm-media
S3_REGION=us-east-1
