# ===========================================
# WhatsApp CRM Backend — Environment Variables
# ===========================================

# Server
PORT=3000
NODE_ENV=development
# NODE_ENV=production  # <-- Ubah ke production saat deploy

# CORS (isi domain frontend saat production)
CORS_ORIGIN=*
# CORS_ORIGIN=https://crm.domainanda.com  # <-- Production

# Public URL of the app (HTTPS). Meta downloads outgoing media from here — required in production.
PUBLIC_APP_URL=
# Contact e-mail shown on /privacy, /terms and /data-deletion (required for Meta App Review)
LEGAL_CONTACT_EMAIL=

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wa_crm

# Redis
# Antrean webhook opsional. Default: webhook dibalas langsung & diproses di latar belakang (tanpa Redis).
# Isi "redis" untuk menyimpan event di Redis + BullMQ (dengan retry). Butuh REDIS_HOST/PORT/PASSWORD.
WEBHOOK_QUEUE=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (WAJIB ganti di production!)
# Kosong/default → server otomatis membuat secret acak di file .jwt-secret
# Buat sendiri: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
# WhatsApp Embedded Signup (Tech Provider): Configuration ID from
# Meta App → Facebook Login for Business → Configurations (template "WhatsApp Embedded Signup").
# When set, "Hubungkan dengan Facebook" opens the real Embedded Signup, where tenants can
# create/choose their WABA and number. Empty = plain Facebook OAuth (existing WABA only).
META_ES_CONFIG_ID=
META_ACCESS_TOKEN=
# Token/WABA/nomor di atas TIDAK dipakai untuk tenant, kecuali diizinkan di bawah.
# Isi true hanya untuk instalasi satu organisasi yang memang memakai nomor platform.
META_PLATFORM_FALLBACK=false
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=my-custom-verify-token
META_API_VERSION=v20.0

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wa-crm-media
S3_REGION=us-east-1

# Akun Super Admin pertama (hanya dipakai saat tabel super_admins masih kosong)
# Jika password kosong, password acak dicetak sekali di log saat server start.
INITIAL_SUPER_ADMIN_EMAIL=admin@perusahaan.com
INITIAL_SUPER_ADMIN_PASSWORD=

# Proxy tambahan di depan nginx lokal (mis. server reverse proxy terpisah). Isi IP-nya, atau awalan
# seperti "10.90." — agar batas login per-IP memakai IP asli pengunjung, bukan IP proxy.
TRUSTED_PROXIES=
